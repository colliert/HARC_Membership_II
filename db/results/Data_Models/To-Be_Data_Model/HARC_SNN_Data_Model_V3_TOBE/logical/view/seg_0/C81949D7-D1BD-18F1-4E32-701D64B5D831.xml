<userDefinedSQL><![CDATA[/*
* v_harc_snn_callout_roster_random
* --------------------------------
*
* Author:  Tim Collier
*
* Purpose:  using the regular callout as the basis, randomly order the roster.
*
*/
select callsign
    ,"first name"
    ,"last name"
    ,member
    ,comments
    ,Cutoff_Days
from (select random()
            ,callsign
            ,"first name"
            ,"last name"
            ,member
            ,comments
            ,Cutoff_Days
from (select * from v_harc_snn_callout_roster)
order by 5,1)]]></userDefinedSQL>
