<userDefinedSQL><![CDATA[select count(qso_start) as 'Checkins'
        ,date(qso_start) as 'Net_Date'
from v_net_qso
where date(qso_start) in
            (select  date((select max(qso_start)
            from v_net_qso)) as 'Latest_Net_Date')]]></userDefinedSQL>
