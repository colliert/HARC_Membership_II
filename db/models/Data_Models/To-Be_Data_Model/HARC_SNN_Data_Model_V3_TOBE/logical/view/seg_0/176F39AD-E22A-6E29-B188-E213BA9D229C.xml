<userDefinedSQL><![CDATA[/*
* v_harc_snn_callout_roster_reverse
* ---------------------------------
*
* Author: Tim Collier
* 
* Purpose:  Using the basic callout roster (v_harc_snn_callout_roster) as a base, list the roster in 
* reverse order (last name descending, first name descending).
*/
select callsign
    ,"first name"
    ,"last name"
    ,member
    ,comments
    ,Cutoff_Days
from (select callsign
            ,"first name"
            ,"last name"
            ,member
            ,comments
            ,Cutoff_Days
from (select * from v_harc_snn_callout_roster)
order by 5,"last name" desc, "first name" desc)]]></userDefinedSQL>
