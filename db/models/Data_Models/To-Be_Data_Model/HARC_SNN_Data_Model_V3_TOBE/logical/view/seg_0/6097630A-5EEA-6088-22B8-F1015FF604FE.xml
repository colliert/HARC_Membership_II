<userDefinedSQL><![CDATA[/*
* v_callsign_suffix
* -----------------
*
* Author Tim Collier
* Purpose:  Generate a list of call sign suffixes of those stations who have checked into the net.
*  The callsign suffix may be used as a quick visual lookup of stations.
*
*/
select distinct a.call as Call
    ,a.first_name as First_Name
    ,a.last_name as Last_Name
    ,case cast(substr(a.call,2,1) as integer)
        when 0 then substr(a.call,4,length(call))
        else substr(call,3,length(a.call))
    end as Suffix
from v_net_qso a
order by 4]]></userDefinedSQL>
