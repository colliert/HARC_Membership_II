digraph "HARC_SNN_3_PROD.sql" {

splines  = ortho;
fontname = "Inconsolata";

node [colorscheme = ylgnbu4];
edge [colorscheme = dark28, dir = both];

qso_table_v008                    [shape = record, label = "{ qso_table_v008 |  my_grid : text\l  my_call : text\l  my_rig : text\l  call : text\l  first_name : text\l  last_name : text\l  street : text\l  city : text\l  county : text\l  state : text\l  postal_country : text\l  zip : text\l  grid : text\l  dxcc_country : text\l  iota : text\l  sota : text\l  cq_zone : text\l  itu : text\l  ten_ten : text\l  email : text\l  url : text\l  mode : text\l  band_rx : text\l  band_tx : text\l  rst_sent : text\l  rst_received : text\l  qsl_via : text\l  qsl_sent : text\l  qsl_received : text\l  srx : text\l  stx : text\l  comments : text\l  satellite : text\l  qso_start : real\l  qso_done : real\l  latitude : real\l  longitude : real\l  tx_frequency : real\l  rx_frequency : real\l  azimuth : real\l  elevation : real\l  power : real\l  srx_numeric : integer\l  stx_numeric : integer\l  dxcc_id : integer\l  contest_id : text\l  my_sota : text\l  skcc : text\l  pota : text\l  my_pota : text\l  wwff : text\l  my_wwff : text\l  sig : text\l  my_sig : text\l  sig_info : text\l  my_sig_info : text\l  ext_val_1 : text\l  ext_val_2 : text\l  ext_val_3 : text\l  ext_val_4 : text\l  distance : real\l| pk : integer\l }"];
