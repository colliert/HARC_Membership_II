v_call_out_cutoff_days            [shape = record, label = "{ v_call_out_cutoff_days |  dat_est : text\l  num_days : integer\l }"];
"v_check-ins_for_web_display"     [shape = record, label = "{ v_check-ins_for_web_display |  Callsign : text\l  First_Name : unknown\l  Last_Name : text\l  Checkin_Date(UTC) : text\l }"];
v_checkins_most_recent_net        [shape = record, label = "{ v_checkins_most_recent_net |  call : text\l  first_name : text\l  last_name : text\l  UTC_Checkin_Date : text\l  UTC_Time : text\l  Member_Status : number\l }"];
v_count_qso_by_date               [shape = record, label = "{ v_count_qso_by_date |  qso_date : text\l  count(qso_date) : unknown\l }"];
v_current_call_out_cutoff_days    [shape = record, label = "{ v_current_call_out_cutoff_days |  current_num_days : integer\l }"];
v_harc_snn_callout_roster         [shape = record, label = "{ v_harc_snn_callout_roster |  Callsign : text\l  First Name : unknown\l  Last Name : text\l  Member : unknown\l  Comments : unknown\l  Cutoff_Days : integer\l }"];
