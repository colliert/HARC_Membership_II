v_harc_snn_callout_roster_reverse [shape = record, label = "{ v_harc_snn_callout_roster_reverse |  callsign : text\l  first name : unknown\l  last name : text\l  member : unknown\l  comments : unknown\l  Cutoff_Days : integer\l }"];
