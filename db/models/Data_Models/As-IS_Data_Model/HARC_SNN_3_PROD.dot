v_maint_add_as_mem                [shape = record, label = "{ v_maint_add_as_mem |  call : text\l  f_nam : text\l  l_nam : text\l  roster : text\l }"];
v_maint_add_person_to_pers        [shape = record, label = "{ v_maint_add_person_to_pers |  call : text\l  net_id : text\l  f_nam : text\l  l_nam : text\l  qso_date : text\l }"];
v_maint_cha_nonmember_to_member   [shape = record, label = "{ v_maint_cha_nonmember_to_member |  call : text\l  f_nam : text\l  l_nam : text\l  roster : text\l }"];
v_maint_latest_hcol_join_date     [shape = record, label = "{ v_maint_latest_hcol_join_date |  call : text\l  First_Name : text\l  Last_Name : text\l  Latest_Join_Date : unknown\l }"];
v_maint_remove_as_member          [shape = record, label = "{ v_maint_remove_as_member |  pers_call : text\l  pers_f_nam : text\l  pers_l_nam : text\l }"];
v_maint_show_dupes                [shape = record, label = "{ v_maint_show_dupes |  item_checked : blob\l  dupe_type : unknown\l  num_found : unknown\l }"];
v_net_qso                         [shape = record, label = "{ v_net_qso |  QSO_Key : numeric\l  call : text\l  net_id : text\l  f_nam : text\l  l_nam : text\l  qso_date : text\l  qso_time : text\l }"];
v_pers                            [shape = record, label = "{ v_pers |  pers_call : text\l  pers_f_nam : text\l  pers_m_nam : text\l  pers_l_nam : text\l  pers_pref_nam : text\l  pers_typ_cd : number\l }"];
v_pers_typ                        [shape = record, label = "{ v_pers_typ |  pers_typ_cd : numeric\l  pers_typ_desc : text\l }"];
v_potential_callout_roster_size   [shape = record, label = "{ v_potential_callout_roster_size |  Days_since_last_checkin : unknown\l  Potential_number_of_callouts : unknown\l }"];
v_qso_table_v008                  [shape = record, label = "{ v_qso_table_v008 |  pk : integer\l  my_grid : text\l  my_call : text\l  my_rig : text\l  call : text\l  first_name : text\l  last_name : text\l  street : text\l  city : text\l  county : text\l  state : text\l  postal_country : text\l  zip : text\l  grid : text\l  dxcc_country : text\l  iota : text\l  sota : text\l  cq_zone : text\l  itu : text\l  ten_ten : text\l  email : text\l  url : text\l  mode : text\l  band_rx : text\l  band_tx : text\l  rst_sent : text\l  rst_received : text\l  qsl_via : text\l  qsl_sent : text\l  qsl_received : text\l  srx : text\l  stx : text\l  comments : text\l  satellite : text\l  qso_start : real\l  qso_done : real\l  latitude : real\l  longitude : real\l  tx_frequency : real\l  rx_frequency : real\l  azimuth : real\l  elevation : real\l  power : real\l  srx_numeric : integer\l  stx_numeric : integer\l  dxcc_id : integer\l  contest_id : text\l  my_sota : text\l  skcc : text\l  pota : text\l  my_pota : text\l  wwff : text\l  my_wwff : text\l  sig : text\l  my_sig : text\l  sig_info : text\l  my_sig_info : text\l  ext_val_1 : text\l  ext_val_2 : text\l  ext_val_3 : text\l  ext_val_4 : text\l  distance : real\l }"];
