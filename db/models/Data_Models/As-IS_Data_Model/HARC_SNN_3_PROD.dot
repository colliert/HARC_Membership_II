sqlite_master                     [shape = record, label = "{ sqlite_master |  type : text\l  name : text\l  tbl_name : text\l  rootpage : int\l  sql : text\l }"];
t_call_out_cutoff_days            [shape = record, label = "{ t_call_out_cutoff_days |  num_days : integer\l| dat_est : text\l }"];
t_hcol_export                     [shape = record, label = "{ t_hcol_export |  mem_num : numeric\l  roster : text\l  f_nam : text\l  pref_nam : text\l  l_nam : text\l  call : text\l  lic_cls : text\l  lic_exp_dat : text\l  lic_num : text\l  lic_agncy : text\l  street : text\l  city : text\l  st : text\l  zip : text\l  country_cd : text\l  lat : numeric\l  lon : numeric\l  elev : numeric\l  hcol_emal : text\l  hcol_email_stat : text\l  club_email : text\l  club_email_stat : text\l  phone_pri : text\l  phone_pri_typ : text\l  phone_pri_pub : text\l  phone_alt : text\l  phone_alt_typ : text\l  phone_alt_pub : text\l  emer_cntct : text\l  join_dat : text\l  left_dat : text\l  club_rank : text\l  club_pos : text\l  dele : text\l  mem_typ : text\l  mem_exp_dat : text\l  club_bal : numeric\l  dob : text\l  priv_mem : numeric\l  tz : text\l  lst_login : text\l  role_cnt : numeric\l }"];
