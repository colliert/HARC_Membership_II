<userDefinedSQL><![CDATA[select callsign
    ,"first name"
    ,"last name"
    ,member
    ,comments
    ,Cutoff_Days
from (select random()
            ,callsign
            ,"first name"
            ,"last name"
            ,member
            ,comments
            ,Cutoff_Days
from (select * from v_harc_snn_callout_roster)
order by 5,1)]]></userDefinedSQL>
