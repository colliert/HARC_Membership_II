<userDefinedSQL><![CDATA[SELECT callsign,
           "first name",
           "last name",
           member,
           comments
      FROM
           (
               SELECT random(),
                      callsign,
                      "first name",
                      "last name",
                      member,
                      comments
                 FROM
                      (
                          SELECT *
                            FROM v_harc_snn_callout_roster
                      )
                ORDER BY 5,
                         1
           )]]></userDefinedSQL>
